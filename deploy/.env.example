# 复制为 .env 后填入真实值（.env 已在 .gitignore 中，不会入库）

# 票据签名密钥（必填）：服务端签发与校验访问票据用，绝不出现在前端
# 生成：openssl rand -hex 32
SIGNING_SECRET=
# 后台登录口令（选填）：不设置时 /api/admin/* 全部返回 403
# 生成：openssl rand -hex 16
ADMIN_TOKEN=
# 来源白名单，逗号分隔；留空则不校验来源（Docker 同源部署 / 本地调试）
ALLOWED_ORIGINS=https://pw.qianxian.tech
# 只读票据有效期（毫秒），默认 600000（10 分钟）
TICKET_TTL_MS=600000
# 票据是否绑定客户端 IP：1 开启 / 0 关闭（默认 0，避免用户切换网络被误伤）
TICKET_BIND_IP=0
# 前端对外端口
WEB_PORT=8080
