/* 全局样式 */
page {
  background-color: #f5f7fa;
  font-family: '微软雅黑', Arial, sans-serif;
  padding: 20px;
}

/* 弹窗样式 */
.popup-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.7);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 9999;
}

.popup-content {
  background-color: white;
  border-radius: 12px;
  padding: 30px;
  max-width: 80%;
  max-height: 80%;
  overflow-y: auto;
  text-align: center;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
}

.popup-title {
  color: #2c3e50;
  margin-bottom: 20px;
  font-size: 20px;
  font-weight: bold;
  display: block;
}

.popup-message {
  margin-bottom: 30px;
  text-align: justify;
  line-height: 1.6;
}

.popup-text {
  margin-bottom: 15px;
  color: #34495e;
  display: block;
  font-size: 13px;
}

.popup-button {
  padding: 12px 30px;
  background-color: #3498db;
  color: white;
  border: none;
  border-radius: 6px;
  font-size: 16px;
}

.popup-button:active {
  background-color: #1f618d;
}

/* 容器样式 */
.container {
  max-width: 1080px;
  margin: 0 auto;
  text-align: center;
}

/* 头部样式 */
.header {
  margin-bottom: 20px;
}

.title {
  color: #2c3e50;
  font-size: 20px;
  font-weight: bold;
  display: block;
}

.subtitle {
  color: #2c3e50;
  font-size: 20px;
  font-weight: bold;
  display: block;
  margin-top: 5px;
}

/* 链接按钮样式 */
.link-buttons {
  display: flex;
  gap: 10px;
  margin-bottom: 15px;
  justify-content: center;
  flex-wrap: wrap;
}

.link-button {
  flex: 1;
  min-width: 100px;
  max-width: 120px;
  padding: 10px 15px;
  background-color: #4CAF50;
  color: white;
  border: none;
  border-radius: 6px;
  font-size: 14px;
}

.link-button:active {
  background-color: #45a049;
}

/* 抖音信息样式 */
.douyin-info {
  background-color: #e74c3c;
  color: white;
  padding: 8px;
  border-radius: 8px;
  margin-bottom: 10px;
  font-weight: bold;
  display: inline-block;
  font-size: 14px;
}

/* 选择器行样式 - 每行独立显示 */
.selector-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 15px;
  width: 100%;
}

.section-title-inline {
  font-size: 14px;
  font-weight: bold;
  color: #34495e;
  white-space: nowrap;
  min-width: 120px;
  text-align: right;
}

.car-picker-inline,
.version-picker-inline {
  flex: 1;
}

.picker-value-inline {
  background-color: #FF9800;
  color: white;
  padding: 10px 15px;
  border-radius: 6px;
  font-size: 14px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
}

.version-picker-inline .picker-value-inline {
  background-color: #3498db;
}

.timezone-picker-inline {
  flex: 1;
}

.timezone-picker-inline .picker-value-inline {
  background-color: #4CAF50;
}

.version-button {
  padding: 6px 12px;
  border: 1px solid #3498db;
  border-radius: 15px;
  background-color: white;
  color: #3498db;
  font-size: 12px;
  transition: all 0.3s ease;
}

.version-button.active {
  background-color: #3498db;
  color: white;
  font-weight: bold;
}

/* 口令组样式 */
.hour-password-group {
  border: 2px solid #3498db;
  border-radius: 12px;
  padding: 20px;
  margin-bottom: 30px;
  background-color: rgba(255, 255, 255, 0.9);
}

.hour-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8px;
  font-size: 20px;
  font-weight: bold;
  margin-bottom: 20px;
  text-align: center;
  color: #34495e;
}

.copy-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  margin: 0;
  padding: 0 14px;
  height: 30px;
  border-radius: 15px;
  background-color: #3498db;
  color: #ffffff;
  font-size: 13px;
  font-weight: normal;
  line-height: 1;
}
button.copy-btn::after {
  border: none;
}

.highlight {
  color: #e74c3c;
  font-weight: bold;
}

.password-group {
  display: flex;
  flex-direction: column;
  gap: 25px;
}

/* 验证密码悬浮窗 */
.verify-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(20, 24, 38, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  z-index: 999;
}
.verify-modal {
  width: 100%;
  max-width: 320px;
  background: #fff;
  border-radius: 14px;
  padding: 22px 20px 18px;
  box-shadow: 0 18px 50px rgba(20, 24, 38, 0.28);
}
.verify-title {
  font-size: 18px;
  font-weight: bold;
  color: #1c2333;
  display: block;
}
.verify-input {
  margin-top: 16px;
  border: 1px solid #e6e9f2;
  border-radius: 8px;
  padding: 12px;
  font-size: 20px;
  text-align: center;
  letter-spacing: 6px;
  background: #fff;
}
.verify-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 20px;
}
.verify-btn {
  margin: 0;
  padding: 0 20px;
  height: 38px;
  line-height: 38px;
  font-size: 14px;
  border-radius: 8px;
  color: #fff;
  background: linear-gradient(135deg, #5b5bd6, #7c3aed);
}
.verify-btn.ghost {
  background: #fff;
  color: #5b5bd6;
  border: 1px solid #5b5bd6;
}
.password-value.locked { color: #95a5a6; }

.password-card {
  background: white;
  border-radius: 12px;
  padding: 30px 20px;
  box-shadow: 0 4px 18px rgba(0, 0, 0, 0.08);
}

.card-title {
  color: #34495e;
  display: block;
  margin-bottom: 20px;
  font-size: 20px;
  font-weight: bold;
}

.password-value {
  font-size: 32px;
  color: #e74c3c;
  font-weight: bold;
  letter-spacing: 2px;
  font-family: 'DS-DIGI ITC', monospace;
  display: block;
  margin-bottom: 10px;
}

.instructions {
  font-size: 0.9em;
  color: #666;
  padding-left: 20px;
  display: block;
  margin-top: 10px;
}

/* 序列号输入样式 */
.serial-number-input {
  margin-bottom: 15px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  width: 100%;
}

.serial-number-input input {
  border: 1px solid #ddd;
  border-radius: 4px;
  padding: 10px;
  width: 100%;
  max-width: 200px;
  font-size: 16px;
  text-align: center;
  height: 44px;
  box-sizing: border-box;
}

.calculate-button {
  margin-top: 10px;
  padding: 10px 20px;
  background-color: #3498db;
  color: white;
  border: none;
  border-radius: 6px;
  font-size: 16px;
  height: 40px;
  box-sizing: border-box;
  text-align: center;
  line-height: 20px;
  white-space: nowrap;
  min-width: 120px;
}

/* 切换按钮样式 */
.toggle-button {
  margin-top: 10px;
  padding: 10px 20px;
  background-color: #3498db;
  color: white;
  border: none;
  border-radius: 6px;
  font-size: 16px;
  height: 40px;
  box-sizing: border-box;
  text-align: center;
  line-height: 20px;
  white-space: nowrap;
  min-width: 120px;
}

/* 更新信息样式 */
.update-info {
  color: #7f8c8d;
  font-size: 16px;
  padding: 15px;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 8px;
  display: inline-block;
}

.car-instructions {
  margin-top: 5px;
  font-size: 0.9em;
  color: #e74c3c;
  font-weight: bold;
  display: block;
}

.notes {
  font-size: 0.9em;
  color: #e74c3c;
  display: block;
  margin-top: 5px;
}
